{
  "name": "code-review-tracker",
  "displayName": "Code Review Tracker",
  "description": "Persistent, line-level code review tracking for VS Code.",
  "version": "0.5.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.127.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Review tracking works in Restricted Mode; configured terminal commands require trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Code Review Tracker requires local workspace files and the local Git executable."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codeReviewTracker.markPending",
        "title": "Code Review: Mark Lines Pending"
      },
      {
        "command": "codeReviewTracker.markInReview",
        "title": "Code Review: Mark Lines In Review"
      },
      {
        "command": "codeReviewTracker.markReviewed",
        "title": "Code Review: Mark Lines Reviewed"
      },
      {
        "command": "codeReviewTracker.markFilePending",
        "title": "Code Review: Mark File Pending"
      },
      {
        "command": "codeReviewTracker.markFileInReview",
        "title": "Code Review: Mark File In Review"
      },
      {
        "command": "codeReviewTracker.markFileReviewed",
        "title": "Code Review: Mark File Reviewed"
      },
      {
        "command": "codeReviewTracker.markFolderReviewed",
        "title": "Code Review: Mark Folder Reviewed"
      },
      {
        "command": "codeReviewTracker.openReviewDiff",
        "title": "Go to Review View",
        "icon": "$(preview)"
      },
      {
        "command": "codeReviewTracker.setup",
        "title": "Code Review: Set Up Tracking"
      },
      {
        "command": "codeReviewTracker.initializeReviewed",
        "title": "Code Review: Mark Entire Workspace Reviewed"
      },
      {
        "command": "codeReviewTracker.initializePending",
        "title": "Code Review: Mark Entire Workspace Pending"
      },
      {
        "command": "codeReviewTracker.sendSelectionToTerminal",
        "title": "Code Review: Send Selection to Agent"
      },
      {
        "command": "codeReviewTracker.refresh",
        "title": "Code Review: Refresh"
      },
      {
        "command": "codeReviewTracker.showLogs",
        "title": "Code Review: Show Logs"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeReviewTracker.openReviewDiff",
          "when": "resourceScheme == file",
          "group": "codeReview@0"
        },
        {
          "command": "codeReviewTracker.markPending",
          "group": "codeReview@1"
        },
        {
          "command": "codeReviewTracker.markInReview",
          "group": "codeReview@2"
        },
        {
          "command": "codeReviewTracker.markReviewed",
          "group": "codeReview@3"
        },
        {
          "command": "codeReviewTracker.sendSelectionToTerminal",
          "group": "codeReview@4"
        }
      ],
      "editor/title": [
        {
          "command": "codeReviewTracker.openReviewDiff",
          "when": "resourceScheme == file",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "codeReviewTracker.markFilePending",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "codeReview@1"
        },
        {
          "command": "codeReviewTracker.markFileInReview",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "codeReview@2"
        },
        {
          "command": "codeReviewTracker.markFileReviewed",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "codeReview@3"
        },
        {
          "command": "codeReviewTracker.markFolderReviewed",
          "when": "resourceScheme == file && explorerResourceIsFolder == true",
          "group": "codeReview@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeReviewTracker.markPending",
        "key": "ctrl+alt+j",
        "when": "editorTextFocus"
      },
      {
        "command": "codeReviewTracker.markInReview",
        "key": "ctrl+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "codeReviewTracker.markReviewed",
        "key": "ctrl+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "codeReviewTracker.sendSelectionToTerminal",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Code Review Tracker",
      "properties": {
        "codeReviewTracker.agentCommand": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Optional command to start a coding agent in a newly created review terminal, for example codex."
        },
        "codeReviewTracker.reviewerName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Fallback reviewer name when Git user.name is unavailable."
        },
        "codeReviewTracker.reviewerEmail": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Fallback reviewer email when Git user.email is unavailable."
        },
        "codeReviewTracker.maxFileSizeBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 1024,
          "scope": "window",
          "description": "Largest file the extension will read for line review tracking."
        },
        "codeReviewTracker.openFilesInReviewView": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Open tracked files in the review view by default. The baseline on the left is read-only; the current file on the right remains editable."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeReviewTracker",
          "title": "Code Review",
          "icon": "resources/review.svg"
        }
      ]
    },
    "views": {
      "codeReviewTracker": [
        {
          "id": "codeReviewTracker.files",
          "name": "Review Files"
        }
      ]
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "pnpm run check-types && node esbuild.js",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src test --max-warnings=0 && pnpm run check:integration",
    "check:integration": "node --check test/integration/run.mjs && node --check test/integration/suite/index.js",
    "test:unit": "node --import tsx --test test/**/*.test.ts",
    "test:integration": "pnpm run build && node test/integration/run.mjs",
    "test": "pnpm run check-types && pnpm run lint && pnpm run test:unit && pnpm run test:integration",
    "package": "pnpm run check-types && pnpm run build",
    "package:vsix": "pnpm exec vsce package --no-dependencies --no-rewrite-relative-links --allow-missing-repository",
    "vscode:prepublish": "pnpm run package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
